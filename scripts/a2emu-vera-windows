#!/bin/bash
# a2emu-vera-windows: place an emulator's windows with the window manager (wmctrl),
# never overlapping: the emulator TOP-LEFT, VERA BOTTOM-RIGHT of a display.  Works
# for every emulator with a VERA window titled "VERA [<machine>]": a2emu ("VERA [A2]"),
# VICE ("VERA [C64]"), atari800 ("VERA [A8]").
#
# Usage: a2emu-vera-windows [--pid PID] [--left] [--timeout SECONDS] [--print]
#                           [--main TITLE] [--vera TITLE]
#   --pid      only the windows of this process (default: any matching window)
#   --left     the display at x = 0 instead of the primary one
#   --timeout  how long to wait for both windows (default 10 s)
#   --print    only print where the windows would go
#   --vera     VERA window title substring (default "VERA [", any machine)
#   --main     emulator window title substring (default: the other window of the
#              process that owns the VERA window)
#
# Nothing is fixed: the displays come from xrandr (primary, else the first one),
# the panels from each dock's _NET_WM_STRUT_PARTIAL (only those on that display),
# the frame extents and the VERA size from the window itself.  Needs X11 with
# wmctrl, xrandr, xprop and xwininfo.

PID=
MAIN=
VTITLE="VERA ["
PRINT=0
LEFT=0
TIMEOUT=10
while [ $# -gt 0 ]; do
    case $1 in
        --pid) shift; PID=$1 ;;
        --main) shift; MAIN=$1 ;;
        --vera) shift; VTITLE=$1 ;;
        --left) LEFT=1 ;;
        --print) PRINT=1 ;;
        --timeout) shift; TIMEOUT=$1 ;;
        --help|-h) sed -n "2,19p" "$0"; exit 0 ;;
    esac
    shift
done

# the display WxH+X+Y: connected outputs with a mode (disabled ones have none)
OUTS=$(xrandr --query | grep ' connected')
if [ $LEFT = 1 ]; then
    GEOM=$(grep -o '[0-9]*x[0-9]*+0+[0-9]*' <<< "$OUTS" | head -1)
else
    GEOM=$(grep ' connected primary' <<< "$OUTS" | grep -o '[0-9]*x[0-9]*+[0-9]*+[0-9]*' | head -1)
fi
[ -n "$GEOM" ] || GEOM=$(grep -o '[0-9]*x[0-9]*+[0-9]*+[0-9]*' <<< "$OUTS" | head -1)
[ -n "$GEOM" ] || { echo "a2emu-vera-windows: no display found (xrandr)" >&2; exit 1; }
IFS='x+' read -r DW DH DX DY <<< "$GEOM"

# usable area of that display: the screen minus the panels that touch it.
# A strut is measured from the edge of the whole X screen (RW x RH).
RW=$(xwininfo -root | awk '/Width:/ {print $2}')
RH=$(xwininfo -root | awk '/Height:/ {print $2}')
L=$DX; T=$DY; R=$((DX + DW)); B=$((DY + DH))
for w in $(xprop -root _NET_CLIENT_LIST | sed 's/.*# //; s/,//g'); do
    s=$(xprop -id "$w" _NET_WM_STRUT_PARTIAL 2>/dev/null | sed -n 's/.*= //p' | tr -d ,)
    if [ -z "$s" ]; then                           # old-style strut: the whole edge
        s=$(xprop -id "$w" _NET_WM_STRUT 2>/dev/null | sed -n 's/.*= //p' | tr -d ,)
        [ -n "$s" ] && s="$s 0 $((RH - 1)) 0 $((RH - 1)) 0 $((RW - 1)) 0 $((RW - 1))"
    fi
    [ -n "$s" ] || continue
    read -r sl sr st sb ly0 ly1 ry0 ry1 tx0 tx1 bx0 bx1 <<< "$s"
    # each strut counts only where its span overlaps this display
    [ "$st" -gt 0 ] && [ "$tx1" -ge "$DX" ] && [ "$tx0" -lt "$R" ] && [ "$st" -gt "$T" ] && T=$st
    [ "$sb" -gt 0 ] && [ "$bx1" -ge "$DX" ] && [ "$bx0" -lt "$R" ] && [ $((RH - sb)) -lt "$B" ] && B=$((RH - sb))
    [ "$sl" -gt 0 ] && [ "$ly1" -ge "$DY" ] && [ "$ly0" -lt "$((DY + DH))" ] && [ "$sl" -gt "$L" ] && L=$sl
    [ "$sr" -gt 0 ] && [ "$ry1" -ge "$DY" ] && [ "$ry0" -lt "$((DY + DH))" ] && [ $((RW - sr)) -lt "$R" ] && R=$((RW - sr))
done

# wait for a window whose title contains $1 (empty: any) and not $2, print its id
# and its PID.  The title is the text after the 4th column (id desktop pid host).
wait_win() {
    local i w
    for i in $(seq $((TIMEOUT * 10))); do
        w=$(wmctrl -lp | awk -v t="$1" -v x="$2" -v p="$PID" '{
                s = $0; for (k = 0; k < 4; k++) sub(/^[^ ]+ +/, "", s)
                if (index(s, t) && !(x != "" && index(s, x)) && (p == "" || $3 == p)) { print $1, $3; exit }
            }')
        [ -n "$w" ] && { echo "$w"; return 0; }
        sleep 0.1
    done
    return 1
}

read -r VERA VPID <<< "$(wait_win "$VTITLE")"
[ -n "$VERA" ] || { echo "a2emu-vera-windows: no \"$VTITLE\" window" >&2; exit 1; }
[ -n "$PID" ] || [ -n "$MAIN" ] || PID=$VPID    # the emulator: the VERA window's process
read -r A2 _ <<< "$(wait_win "$MAIN" "$VTITLE")"
[ -n "$A2" ] || { echo "a2emu-vera-windows: no emulator window${MAIN:+ \"$MAIN\"}" >&2; exit 1; }

# frame extents l r t b and client size of a window
frame() { xprop -id "$1" _NET_FRAME_EXTENTS 2>/dev/null | sed -n 's/.*= //p' | tr -d ,; }
size()  { xwininfo -id "$1" | awk '/Width:/ {w = $2} /Height:/ {h = $2} END {print w, h}'; }
read -r AL AR AT AB <<< "$(frame "$A2")";   AL=${AL:-0} AR=${AR:-0} AT=${AT:-0} AB=${AB:-0}
read -r VL VR VT VB <<< "$(frame "$VERA")"; VL=${VL:-0} VR=${VR:-0} VT=${VT:-0} VB=${VB:-0}
read -r AW AH <<< "$(size "$A2")"
read -r VW VH <<< "$(size "$VERA")"

# frame rectangles: Apple II at (L,T), VERA ending at (R,B)
VX=$((R - VW - VL - VR)); VY=$((B - VH - VT - VB))
if [ $((L + AW + AL + AR)) -gt "$VX" ] && [ $((T + AH + AT + AB)) -gt "$VY" ]; then
    echo "a2emu-vera-windows: warning: the display ($GEOM, usable $((R - L))x$((B - T))) is too small, the windows overlap" >&2
fi

if [ $PRINT = 1 ]; then
    echo "display $GEOM usable $L,$T-$R,$B  apple2 $L,$T  vera $VX,$VY"; exit 0
fi

# wmctrl -e takes frame coordinates
wmctrl -i -r "$A2" -e "0,$L,$T,-1,-1"
wmctrl -i -r "$VERA" -e "0,$VX,$VY,-1,-1"
