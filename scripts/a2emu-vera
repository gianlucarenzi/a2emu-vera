#!/bin/bash
# a2emu-vera: start this tree's a2emu and place its windows with the window
# manager (a2emu-vera-windows): Apple II TOP-LEFT, VERA BOTTOM-RIGHT.
#
# Usage: a2emu-vera [a2emu-options] [disk]
# Example: a2emu-vera disk.dsk
#          A2_MODEL=iiee A2_AUX=64 a2emu-vera disk.dsk
#          A2_VERA_SLOT=5 a2emu-vera disk.dsk

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
A2EMU_DIR="$(dirname "$SCRIPT_DIR")"

# a2emu loads rom/ and assets/ from the current directory: make the file
# arguments absolute, then run it from the tree
declare -a ARGS
for arg in "$@"; do
    case $arg in
        /*|-*) ARGS+=("$arg") ;;
        *) if [ -e "$arg" ]; then ARGS+=("$PWD/$arg"); else ARGS+=("$arg"); fi ;;
    esac
done

cd "$A2EMU_DIR" || exit 1
./a2emu "${ARGS[@]}" &
A2EMU_PID=$!

"$SCRIPT_DIR/a2emu-vera-windows" --pid $A2EMU_PID || true

wait $A2EMU_PID
