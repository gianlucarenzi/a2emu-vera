#!/bin/bash
# a2emu-vera launcher wrapper: starts a2emu and automatically positions windows.
# Windows are positioned using wmctrl: a2emu (Reinette) TOP-LEFT, VERA BOTTOM-RIGHT.
# The mouse cursor is hidden by a2emu itself.
#
# Usage: a2emu-vera [a2emu-options]
# Example: a2emu-vera disk.po
#          A2_MODEL=iiee a2emu-vera --aux 64 disk.po

set -e

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
A2EMU_DIR="$(dirname "$SCRIPT_DIR")"

# Save the current directory for relative paths
WORK_DIR="$PWD"

# Convert relative arguments to absolute paths
declare -a ARGS
for arg in "$@"; do
    case $arg in
        /*|-*) ARGS+=("$arg") ;;
        *) [ -e "$arg" ] && ARGS+=("$WORK_DIR/$arg") || ARGS+=("$arg") ;;
    esac
done

# Change to a2emu directory and start a2emu in background
cd "$A2EMU_DIR"
"$A2EMU_DIR/a2emu" "${ARGS[@]}" &
A2EMU_PID=$!

# Give a2emu time to create windows, then position them
sleep 0.5
"$SCRIPT_DIR/a2emu-vera-windows" || true

# Wait for a2emu to finish
wait $A2EMU_PID
